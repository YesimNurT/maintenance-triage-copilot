# Copy to .env and fill in. Never commit .env.
# ---------------------------------------------------------------

# --- LLM (Gemini) -----------------------------------------------
# langchain-google-genai and the google-genai SDK read GOOGLE_API_KEY.
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Vector store (Pinecone) ------------------------------------
PINECONE_API_KEY=
PINECONE_INDEX_NAME=mtc-maintenance-cases
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

# --- Tracing (LangSmith) ----------------------------------------
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=maintenance-triage-copilot
# Only if your LangSmith account is in the EU region:
# LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com

# --- Kaggle (dataset download via API) --------------------------
# Alternatively place kaggle.json in ~/.kaggle/ and leave these empty.
KAGGLE_USERNAME=
KAGGLE_KEY=

# --- AWS (local use only; CI uses OIDC, no keys) ----------------
# Use a named profile from `aws configure --profile mtc`.
AWS_PROFILE=mtc
AWS_REGION=eu-central-1
S3_BUCKET=

# --- Project -------------------------------------------------------
DATA_DIR=data
NGAFID_RAW_DIR=data/raw/ngafid
RESULTS_DIR=results
ZENODO_RECORD_ID=6624956
RANDOM_SEED=42
LOG_LEVEL=INFO
